{
  "name": "@raihan004/date-range-picker",
  "version": "0.2.0",
  "description": "Reusable React date range picker and date filtering helpers for Shopify apps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "UNLICENSED",
  "author": "mhraihan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhraihan/date-range-picker.git"
  },
  "homepage": "https://github.com/mhraihan/date-range-picker#readme",
  "bugs": {
    "url": "https://github.com/mhraihan/date-range-picker/issues"
  },
  "keywords": [
    "date-range-picker",
    "react",
    "shopify",
    "raihan004",
    "date-filter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.7"
  }
}
